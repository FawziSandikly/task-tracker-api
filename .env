# Environment configuration file loaded by python-dotenv
# Copy this file to .env and customize for your environment

APP_NAME="Task Tracker API"
APP_VERSION="1.0.0"
DEBUG=True

# Database URL format: sqlite:///path/to/database.db
# ./database.db creates file in current directory
DATABASE_URL=sqlite:///./task_tracker.db

# API configuration
API_PREFIX=/api/v1